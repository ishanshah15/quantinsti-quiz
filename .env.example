# Copy to .env and fill in. Everything here is optional: without Sheets
# credentials the quiz runs normally, it just doesn't persist anything.

# Path to the Google service-account key. If a file named service_account.json
# sits next to server.py it is picked up automatically and this can be left out.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Or paste the raw key JSON instead of a file path (used on Render/Railway).
# GOOGLE_SERVICE_ACCOUNT_JSON=

# The spreadsheet holding the Quiz Library, Results and session_state tabs.
# Defaults to the shared QuantInsti quiz sheet if left unset.
QUIZ_SHEET_ID=1m3jDIXVvHAFN4glTrTRHNFF1wskUHK1DvzPKBVl9y_o

# Host Panel sign-in. Change these before any real deployment.
ADMIN_USER=admin
ADMIN_PASS=pass@123

# Optional label shown on the host and participant pages (e.g. "Mumbai").
INSTANCE_LABEL=
